            {
              "id": "stage-b",
              "label": "B · 原文件",
              "cells": [
                {
                  "text": "if True"
                },
                {
                  "text": "1 / 2"
                },
                {
                  "text": "[完整 B](source:b)"
                }
              ]
            }
          ]
        },
        {
          "id": "s-identity",
          "type": "prose",
          "text": "S 是本页对 `enclosing if` 的简称。这个名字写在 patch 的片段标记里，不会作为代码写入 B。两侧 S 内容相同，第二段才删掉列表项 3。"
        }
      ]
    },
